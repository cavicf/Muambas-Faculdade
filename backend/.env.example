# ==================================================
# MONGODB — CATÁLOGO
# ==================================================

# Endereço do MongoDB em execução pelo Docker
MONGO_URI=#mongodb://127.0.0.1:27018

# Nome do banco utilizado pela aplicação
MONGO_DB_NAME=#muambas

# ==================================================
# REDIS — CARRINHO
# ==================================================

# Endereço do Redis em execução pelo Docker
REDIS_URL=#redis://127.0.0.1:6380

# Segredo utilizado para assinar o cookie de visitante.
# Não colocar o segredo real neste arquivo de exemplo.
#COOKIE_SECRET=#

# ==================================================
# BACKEND
# ==================================================

PORT=#3001

# ==================================================
# TODO (AUTENTICACAO)
# ==================================================

# As sessões de login (session:{tokenId}) usam a mesma
# conexão REDIS_URL. Não é necessário outra conexão.

# ==================================================
# POSTGRESQL — USUÁRIOS, ESTOQUE, PEDIDOS E PAGAMENTOS
# ==================================================

# Endereço do PostgreSQL em execução pelo Docker
# (credenciais de desenvolvimento definidas no docker-compose.yml)
POSTGRES_URL=#postgresql://muambas:muambas@127.0.0.1:5433/muambas

# ==================================================
# OUTBOX — SINCRONIZAÇÃO POSTGRESQL -> MONGODB (opcional)
# ==================================================

# Intervalo, em milissegundos, do processador da outbox (padrão: 5000)
#OUTBOX_INTERVAL_MS=#5000
